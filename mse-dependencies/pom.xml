<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.magoo-lau.mse-framework</groupId>
    <artifactId>mse-dependencies</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mse-dependencies</name>
    <description>统一版本仲裁 BOM（所有第三方版本只在此处声明）</description>

    <properties>
        <spring-boot.version>4.0.8</spring-boot.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <dubbo.version>3.3.6</dubbo.version>
        <dubbo-filter-seata.version>3.3.1</dubbo-filter-seata.version>
        <seata.version>2.6.0</seata.version>
        <rocketmq-spring.version>2.3.6</rocketmq-spring.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- OkHttp / Okio：本仓同时存在两条 okhttp 线——Spring AI 内置 openai-java 依赖经典坐标
             okhttp（4.12.0，注意 okhttp 5.x 起经典坐标对 Maven 是不含类的空 jar，不能升级），
             RocketMQ 链上的 opentelemetry-exporter-sender-okhttp 依赖 okhttp-jvm（5.x 才有的坐标）。
             okio 必须统一到 3.16+：okhttp-jvm 5.x 需要 okio.Socket 新接口，旧 okio（3.6 等）在运行期报
             NoSuchMethodError: okio.Okio.socket（模型连通性测试等 OkHttp 出站调用全部失败）；
             okio 3.x 对 okhttp 4.x 向后兼容，故 okio 全局钉 3.16.x 两线通吃 -->
        <okhttp.version>4.12.0</okhttp.version>
        <okhttp-jvm.version>5.2.1</okhttp-jvm.version>
        <okio.version>3.16.1</okio.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <dynamic-datasource.version>4.5.0</dynamic-datasource.version>
        <sa-token.version>1.46.0</sa-token.version>
        <redisson.version>3.50.0</redisson.version>
        <ttl.version>2.14.5</ttl.version>

        <!-- 老版本 dynamic-datasource 需要 jsqlparser 指定大版本，MP 3.5.9+ 同样需要显式声明 -->
        <jsqlparser.version>5.3</jsqlparser.version>

        <!-- Excel 导入导出（用户管理导入/导出） -->
        <easyexcel.version>4.0.3</easyexcel.version>

        <!-- 图形验证码（登录风控验证码，service-auth 使用） -->
        <easy-captcha.version>1.6.2</easy-captcha.version>

        <!-- 二维码生成（TOTP 绑定扫码 otpauth URI → PNG，service-system 使用） -->
        <zxing.version>3.5.3</zxing.version>

        <!-- Jinja 模板引擎（mse-ai 工作流模板节点渲染） -->
        <jinjava.version>2.7.2</jinjava.version>

        <!-- GraalVM Polyglot API（mse-ai 工作流代码节点沙箱执行；JS 引擎 org.graalvm.polyglot:js 运行期按需引入） -->
        <graalvm-polyglot.version>24.2.1</graalvm-polyglot.version>

        <!-- 对象存储客户端（S3 兼容协议：RustFS 1.x / MinIO 等）。AWS SDK for Java v2 官方 BOM，
             按需引 software.amazon.awssdk:s3；不引即纯本地文件存储（mse-fs 的 SDK 为 optional） -->
        <aws-sdk.version>2.46.7</aws-sdk.version>

        <!-- 信创数据库驱动：金仓驱动须与服务端版本一致（V8R6=8.6.0，V9 用 9.0.1，可 -Dkingbase-jdbc.version 覆盖） -->
        <dameng-jdbc.version>8.1.3.140</dameng-jdbc.version>
        <kingbase-jdbc.version>8.6.0</kingbase-jdbc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ==================== OkHttp / Okio（两条 okhttp 线 + okio 对齐，见 properties 注释） ====================
                 显式钉版置于各 BOM import 之前（Maven dependencyManagement 先声明者胜出），
                 免受上游 BOM（如 spring-cloud-commons-dependencies）钉版变化影响 -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp-jvm.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio-bom</artifactId>
                <version>${okio.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- ==================== Spring 官方 BOM ==================== -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- ==================== Spring Cloud Alibaba（Nacos 配置/注册等） ==================== -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- ==================== Spring AI（LLM 应用技术积木，业务用不到不引入） ==================== -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- ==================== 对象存储（S3 兼容客户端：RustFS 1.x / MinIO 等，业务按需引入） ==================== -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ==================== RPC / 事务 / 消息 ==================== -->
            <dependency>
                <groupId>com.hubspot.jinjava</groupId>
                <artifactId>jinjava</artifactId>
                <version>${jinjava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.graalvm.polyglot</groupId>
                <artifactId>polyglot</artifactId>
                <version>${graalvm-polyglot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-spring-boot-starter</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <!-- Dubbo 本体 jar（含 config.annotation.@Method/@Argument 等注解）：common-core 以编译期
                 传递依赖引入（RpcService/RpcReference 的 Dubbo 嵌套注解 methods() 属性类型声明用——
                 javac 完成注解符号需 dubbo 类在下游编译类路径）；netty-all 版本随本 BOM 导入的
                 Spring Boot netty 管理对齐；fastjson2 钉高版本对齐其他依赖线 -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>2.0.58</version>
            </dependency>
            <dependency>
                <groupId>org.apache.seata</groupId>
                <artifactId>seata-spring-boot-starter</artifactId>
                <version>${seata.version}</version>
            </dependency>
            <!-- Seata 官方 Dubbo 集成（经 Dubbo 扩展 dubbo-filter-seata 承载）：TransactionPropagationFilter
                 经 Dubbo SPI 自动激活，让 XID 随 @RpcReference 的 Dubbo 调用跨进程传播（微服务间全局事务的前提）。
                 注：org.apache.seata:seata-dubbo:2.6.0 在 Central 上是缺 JAR 的残缺发布，不可用；
                 该扩展依赖的 seata-core/dubbo 均为 optional，版本由本工程 BOM 仲裁（org.apache.seata 2.6.0 + dubbo 3.3.6） -->
            <dependency>
                <groupId>org.apache.dubbo.extensions</groupId>
                <artifactId>dubbo-filter-seata</artifactId>
                <version>${dubbo-filter-seata.version}</version>
            </dependency>
            <!-- Seata 2.x SQL 解析器按 SPI 可选装载：缺失时表元数据降级（主键/索引为空，undo 报错） -->
            <dependency>
                <groupId>org.apache.seata</groupId>
                <artifactId>seata-sqlparser-druid</artifactId>
                <version>${seata.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring.version}</version>
            </dependency>

            <!-- ==================== 数据层 ==================== -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 3.5.9+ 起 starter 不再传递 extension（IService/ServiceImpl/分页对象所在） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot4-starter</artifactId>
                <version>${dynamic-datasource.version}</version>
            </dependency>
            <!-- MP 3.5.9+ 起租户/分页等 InnerInterceptor 拆分到该模块（内含 jsqlparser） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- ==================== Excel 导入导出 ==================== -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>

            <!-- ==================== 图形验证码 / 二维码 ==================== -->
            <dependency>
                <groupId>com.github.whvcse</groupId>
                <artifactId>easy-captcha</artifactId>
                <version>${easy-captcha.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>javase</artifactId>
                <version>${zxing.version}</version>
            </dependency>

            <!-- ==================== 认证授权 ==================== -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-bom</artifactId>
                <version>${sa-token.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ==================== 缓存 / 分布式锁 ==================== -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- 纯 Redisson 客户端（不接管 spring-data-redis ConnectionFactory，
                 避免与 Sa-Token Redis DAO 的 TTL 语义冲突；仅用于分布式锁等原生 API） -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- Seata 2.6 依赖 getColumns 的 COLUMN_KEY 判定主键，Connector/J 9.x 已移除该列，锁 8.x -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.4.0</version>
            </dependency>
            <!-- 信创数据库驱动（均发布于 Maven Central） -->
            <dependency>
                <groupId>com.dameng</groupId>
                <artifactId>DmJdbcDriver18</artifactId>
                <version>${dameng-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.com.kingbase</groupId>
                <artifactId>kingbase8</artifactId>
                <version>${kingbase-jdbc.version}</version>
            </dependency>

            <!-- ==================== 工具 ==================== -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>${ttl.version}</version>
            </dependency>

            <!-- ==================== 本项目模块 ==================== -->
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>common-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>common-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>common-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>common-rpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>common-mq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>common-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>common-mail</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>common-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 启动器区：starter-* 内部装配件（工具本体在 common-*），xxx-starter 使用方入口启动器 -->
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>starter-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>starter-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>starter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>starter-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>starter-rpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>starter-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>starter-bridge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>starter-seata</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>mq-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>mail-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>mono-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>micro-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>api-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>api-tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>api-fs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>api-notify</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>service-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>service-platform</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>service-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>service-job</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
