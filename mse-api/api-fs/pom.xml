<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vip.mseapp</groupId>
        <artifactId>mse-api</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>api-fs</artifactId>
    <name>api-fs</name>
    <description>文件存储服务契约（接口 + Serializable DTO）：上传/元数据/下载/删除等机器语义能力，供其他服务 @RpcReference 消费；实现方为 mse-modules/mse-fs</description>

    <dependencies>
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <!-- 契约 DTO 的日期字段经 @JsonFormat 钉死 JSON 载荷格式（版本随基座 BOM/Boot 托管） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- 仅 AbstractFsModeCondition 条件基类需要（消费模块均传递具备；provided 不把 spring 拖进纯契约消费方） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
