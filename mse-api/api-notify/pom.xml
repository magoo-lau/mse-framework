<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.magoo-lau.mse-framework</groupId>
        <artifactId>mse-api</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>api-notify</artifactId>
    <name>api-notify</name>
    <description>消息通知契约（框架通知中枢）：业务服务经 RemoteNotifyService 投递多渠道通知（渠道目录/租户授权/
        调度与投递日志均在框架 service-system），渠道提供方（IM/短信…）经 RemoteNotifyChannel 自注册</description>

    <dependencies>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <!-- 渠道自注册推送装配：Spring 事件/环境/调度（运行期宿主必带，provided 不污染业务依赖树） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- dubbo 模式推送：编程式 ReferenceConfig（运行期微服务宿主经 micro-starter 提供）；
             common-rpc 提供 DubboRuntimeConfigs（宿主经 starter-rpc 传递） -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>common-rpc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
