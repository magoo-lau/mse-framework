<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 业务工程统一父 pom（独立 pom，不挂 mse-framework parent 链，先例：spring-boot-starter-parent）：
         收编 JDK21 编译、spring-boot 插件、基座 BOM 导入与仓库配置，
         业务工程 parent 指向本 pom 后只需声明自身坐标/模块/自有依赖版本管理 -->
    <groupId>com.github.magoo-lau.mse-framework</groupId>
    <artifactId>mse-starter-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mse-starter-parent</name>
    <description>业务工程统一父 pom：java21/compiler/pluginManagement/基座 BOM/repositories 一处收编，消除各工程重复与版本漂移</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 基座版本：升级基座后改这一处即可 -->
        <mse.version>1.0.0-SNAPSHOT</mse.version>
        <!-- 与 mse-dependencies BOM 的 spring-boot 版本保持一致（升级基座时同步此处，BOM import 不传递属性） -->
        <spring-boot.version>4.0.8</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 基座 BOM：仲裁全部第三方 + 基座模块（common-* / starter-* / service-* / api-*）版本 -->
            <dependency>
                <groupId>com.github.magoo-lau.mse-framework</groupId>
                <artifactId>mse-dependencies</artifactId>
                <version>${mse.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有模块共用的基础依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>
</project>
