<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vip.mseapp</groupId>
        <artifactId>mse-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-ai</artifactId>
    <name>common-ai</name>
    <description>AI 基础设施：Spring AI 2.x ChatClient 装配基线（具体模型 starter 由使用方按需引入）</description>

    <dependencies>
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <!-- 装配基础（common-core 不携带 Spring；对齐 common-rpc 的最小依赖集） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Spring AI 装配基线：仅引入 ChatClient 及其自动装配，不绑定具体模型厂商；
             使用方按需引入 spring-ai-starter-model-openai / -dashscope 等，出现 ChatModel
             Bean 后本模块的 mseChatClient 才会装配（不用不引入，天然可裁剪） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-autoconfigure-model-chat-client</artifactId>
        </dependency>
    </dependencies>
</project>
