<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.magoo-lau.mse-framework</groupId>
        <artifactId>mse-boot</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>boot-system</artifactId>
    <name>boot-system</name>
    <description>系统管理微服务：用户/角色/菜单 + Sa-Token 权限数据源，暴露 RemoteUserService</description>

    <dependencies>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>service-system</artifactId>
        </dependency>
        <!-- 微服务形态基线（micro-starter）：Nacos/Dubbo/actuator/三方言驱动/Seata 内置。
             本服务自带基座实现（service-system），排除契约消费桥接 starter-bridge，避免 RPC 回退 Bean 介入 -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>micro-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.github.magoo-lau.mse-framework</groupId>
                    <artifactId>starter-bridge</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
