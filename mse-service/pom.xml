<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.magoo-lau.mse-framework</groupId>
        <artifactId>mse-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mse-service</artifactId>
    <packaging>pom</packaging>
    <name>mse-service</name>
    <description>业务实现模块（纯 jar，无启动类；由 boot 模块聚合或独立装配）</description>

    <modules>
        <module>service-system</module>
        <module>service-platform</module>
        <module>service-auth</module>
        <module>service-job</module>
    </modules>

    <!-- 业务模块公共依赖：Web/安全/数据层/RPC 装配（starter-* 内部装配件，工具本体经其传递带入） -->
    <dependencies>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>starter-rpc</artifactId>
        </dependency>
    </dependencies>
</project>
